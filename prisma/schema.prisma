generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String         @id @default(uuid())
  username    String
  avatar      String
  accentColor String
  isAdmin     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  lastSeen    DateTime       @default(now())

  sessions      Session[]
  messages      Message[]
  reactions     Reaction[]
  reportsSent   Report[]       @relation("Reporter")
  reportsRecv   Report[]       @relation("ReportedUser")
  blockedUsers  BlockedUser[]  @relation("Blocker")
  blockedBy     BlockedUser[]  @relation("Blocked")
  notifications Notification[]
  presences     Presence[]
  activityLogs  ActivityLog[]

  @@index([lastSeen])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipHash    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Room {
  id            String     @id @default(uuid())
  name          String
  slug          String?    @unique
  description   String?
  geohash       String
  radius        Int        @default(1000) // radius in meters
  radiusMeters  Int        @default(1000)
  type          String     @default("General") // e.g., Coffee Shop, Campus, Airport
  category      String     @default("general")
  latitude      Float      @default(37.7749)
  longitude     Float      @default(-122.4194)
  activityScore Int        @default(0)
  isActive      Boolean    @default(true)
  isPrivate     Boolean    @default(false)
  password      String?
  isOfficial    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  messages          Message[]
  presences         Presence[]
  pushSubscriptions PushSubscription[]

  @@index([geohash])
  @@index([activityScore])
}

model Message {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  content   String
  replyToId String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  expiresAt DateTime?
  isDeleted Boolean   @default(false)

  room    Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo Message?   @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[]  @relation("MessageReplies")
  reactions Reaction[]
  reports   Report[]

  @@index([roomId, createdAt])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  messageId      String?
  reason         String
  status         String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())

  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // MENTION, NEARBY_ACTIVITY, SYSTEM
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Presence {
  id         String   @id @default(uuid())
  userId     String
  roomId     String
  lastActive DateTime @default(now())
  isTyping   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId, lastActive])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id         String   @id @default(uuid())
  roomId     String
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, endpoint])
  @@index([roomId])
  @@index([endpoint])
}

